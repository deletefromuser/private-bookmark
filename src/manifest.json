{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2026.10.22",
  "version_name": "2026-10-22",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/logo_v1.png",
    "96": "icons/logo_v1.png"
  },
  "permissions": ["storage", "tabs", "bookmarks", "history", "webNavigation"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "pages/popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/logo_v1.png",
      "32": "icons/logo_v1.png",
      "64": "icons/logo_v1.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/options/options.html",
    "open_in_tab": true
  }
}
